# Copia este archivo como .env y completa los valores. .env nunca se sube a Git.
#
# La app funciona completa SIN estas variables: medir, observar, ver el
# resultado y el protocolo no usan internet. Solo se necesitarán cuando exista
# el backend opcional (Supabase) descrito en docs/app/11-datos-y-backend.md.

# URL del proyecto Supabase (pública).
EXPO_PUBLIC_SUPABASE_URL=
# Clave «anon» / publicable de Supabase. Es pública por diseño: la protección
# real son las políticas RLS. NUNCA pongas aquí la service_role key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# La clave del proveedor de IA (ANTHROPIC_API_KEY) NO va en la app ni en este
# archivo: vive solo como secreto de la Edge Function en Supabase.

# Firma de publicación de la APK (ver mobile/README.md#firma-de-publicación).
# Defínelas en tu terminal o en los secretos de la CI, no en archivos versionados.
# REFLUYE_KEYSTORE_FILE=
# REFLUYE_KEYSTORE_PASSWORD=
# REFLUYE_KEY_ALIAS=
# REFLUYE_KEY_PASSWORD=
